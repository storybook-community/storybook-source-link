{
  "name": "@storybook-community/storybook-source-link",
  "version": "5.0.0",
  "description": "Provides a link to the story's source in the toolbar",
  "keywords": [
    "storybook-addon",
    "storybook-community",
    "storybook",
    "code",
    "source",
    "link"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybook-community/storybook-source-link.git"
  },
  "type": "module",
  "author": "Jonathan Sirrine <sirrineprogramming@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "build:storybook": "storybook build",
    "build:watch": "pnpm build --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "pack": "pnpm pack --out storybook-source-link-$(date +%s).tgz",
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepare": "husky",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && pnpm semantic-release",
    "release:canary": "pnpm build && auto canary",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "next",
    "@storybook/addon-essentials": "next",
    "@storybook/addon-interactions": "next",
    "@storybook/addon-links": "next",
    "@storybook/blocks": "next",
    "@storybook/icons": "^1.6.0",
    "@storybook/react": "next",
    "@storybook/react-vite": "next",
    "@storybook/test": "next",
    "@storybook/theming": "next",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-istanbul": "4.1.12",
    "auto": "^11.3.6",
    "boxen": "^8.0.1",
    "commitlint": "^20.5.3",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "semantic-release": "^25.0.9",
    "storybook": "next",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.ts"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Source Link (community version)",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://avatars.githubusercontent.com/u/216219414?s=200&v=4"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.19"
  }
}
